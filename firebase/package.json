{
  "name": "akademia-diagnosty-reguly",
  "private": true,
  "type": "module",
  "description": "Testy reguł bazy (firestore.rules) w emulatorze Firebase. Uruchomienie: npm install && npm test",
  "scripts": {
    "test": "firebase emulators:exec --config ../firebase.json --only firestore --project demo-akademia \"node --test testy/reguly.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "firebase-tools": "^15.34.0"
  }
}
